# Optional Groq API key. Groq is preferred when both keys are present.
GROQ_API_KEY=gsk_your-key-here

# Optional Anthropic API key for Claude.
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Model configuration. Set the variable for the provider you selected.
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Backend deployment settings
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
PORT=8000
ENVIRONMENT=development

# Frontend deployment setting (frontend/.env.local for development,
# Vercel project environment variables for production)
VITE_API_URL=http://localhost:8000
